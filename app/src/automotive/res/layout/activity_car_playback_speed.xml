<?xml version="1.0" encoding="utf-8"?>
<!-- Distraction-optimized speed picker: presets, slider and -/+ are all >= 96dp touch targets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/CarText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/car_settings_speed" />

        <TextView
            android:id="@+id/car_speed_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="56sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/car_speed_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/car_speed_minus"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/car_speed_slower"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="40sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/car_speed_slider"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:contentDescription="@string/car_settings_speed"
            android:stepSize="0.05"
            android:valueFrom="0.5"
            android:valueTo="2.5"
            app:labelBehavior="gone"
            app:thumbHeight="56dp"
            app:thumbWidth="16dp"
            app:tickVisible="false"
            app:trackHeight="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/car_speed_plus"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/car_speed_faster"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="40sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/car_speed_done"
        style="@style/CarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:text="@string/car_done" />
</LinearLayout>
