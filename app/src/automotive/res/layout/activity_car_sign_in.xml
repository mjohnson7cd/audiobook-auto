<?xml version="1.0" encoding="utf-8"?>
<!-- Parked-only in-car sign-in. Large type, few touch targets (AAOS driver-distraction guidance). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/car_sign_in_title"
        style="@style/CarText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/car_sign_in_title" />

    <TextView
        android:id="@+id/car_sign_in_message"
        style="@style/CarText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/car_sign_in_link"
        style="@style/CarText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/car_sign_in_link_url"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/car_sign_in_code_label"
        style="@style/CarText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/car_sign_in_enter_code"
        android:visibility="gone" />

    <TextView
        android:id="@+id/car_sign_in_code"
        style="@style/CarText.Code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/car_sign_in_progress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:indeterminate="true" />

    <EditText
        android:id="@+id/car_sign_in_pin"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:autofillHints="password"
        android:gravity="center"
        android:hint="@string/car_sign_in_pin_hint"
        android:imeOptions="actionDone"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:minHeight="76dp"
        android:textSize="32sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/car_sign_in_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:divider="#33FFFFFF"
        android:dividerHeight="1dp"
        android:visibility="gone" />

    <Space
        android:id="@+id/car_sign_in_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/car_sign_in_secondary"
            style="@style/CarButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="@string/car_cancel" />

        <Button
            android:id="@+id/car_sign_in_primary"
            style="@style/CarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
