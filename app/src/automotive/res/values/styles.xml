<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Large-type, high-contrast theme for parked-only in-car screens. -->
    <style name="CarTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CarText.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CarText.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#DDFFFFFF</item>
    </style>

    <style name="CarText.Code" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">96sp</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CarButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">76dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CarButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">76dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
