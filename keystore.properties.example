# Keystore configuration for local release builds
# Copy this file to keystore.properties and fill in your actual values
# DO NOT commit keystore.properties or the keystore to Git! (both are gitignored)
#
# Generate a keystore (keep it OUTSIDE the repo, and back it up -- losing it
# means you can never ship an update signed with the same key):
#   keytool -genkeypair -v -keystore ~/.android-keystores/audiobook-auto-release.jks \
#     -storetype PKCS12 -alias chronicleauto -keyalg RSA -keysize 4096 -validity 10000

# Path to your release keystore file (absolute, or relative to project root)
storeFile=/path/to/audiobook-auto-release.jks

# Password for the keystore
storePassword=YOUR_KEYSTORE_PASSWORD

# Alias of the signing key
keyAlias=chronicleauto

# Password for the signing key (same as storePassword for PKCS12 keystores)
keyPassword=YOUR_KEY_PASSWORD
